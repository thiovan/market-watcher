# Telegram Bot Token (dari @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID Anda (untuk membatasi akses bot)
ADMIN_USER_ID=123456789

# Interval default pengecekan harga (menit)
CHECK_INTERVAL_MINUTES=240

# Path database SQLite
DATABASE_PATH=data/market_watcher.db

# Browser headless mode (true/false, default: true)
# Set false untuk debugging — butuh display/xvfb di VPS
HEADLESS=true
