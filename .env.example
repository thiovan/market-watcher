# Telegram Bot Token (dari @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID Anda (untuk membatasi akses bot)
ADMIN_USER_ID=123456789

# Interval default pengecekan harga (menit)
CHECK_INTERVAL_MINUTES=240

# Path database SQLite
DATABASE_PATH=data/market_watcher.db

# Browser headless mode (true/false, default: false)
# Default false karena headless-shell mudah diblokir anti-bot
# Gunakan xvfb-run di VPS: xvfb-run python run.py
HEADLESS=false

# Jeda antar link dalam satu produk (detik, default: 10)
SCRAPE_DELAY_SECONDS=10

# Jeda antar produk berbeda (detik, default: 30)
# Naikkan jika CPU VPS sering 100%
SCRAPE_BATCH_DELAY_SECONDS=30
